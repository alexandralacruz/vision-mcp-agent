# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL= qwen2.5:7b
OLLAMA_TEMPERATURE=0.1

# Modelos ML (se descargan automáticamente de HuggingFace)
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
BLIP_MODEL_NAME=Salesforce/blip-vqa-base
CLIP_DEVICE=cpu
BLIP_DEVICE=cpu

# Repositorio
REPOSITORY_PATH=repository/storage/images
EMBEDDINGS_PATH=repository/storage/embeddings

# API
API_PORT=8001

# Streamlit
STREAMLIT_API_URL=http://api:8001
